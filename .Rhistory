library(quantmod)
# Define UI
ui <- fluidPage(
titlePanel("Market Making Algorithm with Real-Time Data"),
sidebarLayout(
sidebarPanel(
textInput("ticker", "Stock Ticker:", "AAPL"),
numericInput("capital_limit", "Capital Limit (USD):", 10000, min = 1000, step = 1000),
numericInput("spread", "Bid-Ask Spread (%):", 0.5, min = 0.1, step = 0.1),
numericInput("inventory_limit", "Inventory Limit (Units):", 100, min = 1),
numericInput("n_steps", "Number of Time Steps:", 100, min = 10, step = 10),
