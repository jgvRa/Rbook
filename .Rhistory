library(shiny)
library(ggplot2)
# Define UI
ui <- fluidPage(
titlePanel("Market Making Algorithm Simulator"),
sidebarLayout(
sidebarPanel(
numericInput("initial_price", "Initial Market Price:", 100, min = 1),
numericInput("spread", "Bid-Ask Spread (%):", 0.5, min = 0.1, step = 0.1),
numericInput("volatility", "Price Volatility (%):", 1, min = 0.1, step = 0.1),
numericInput("inventory_limit", "Inventory Limit:", 100, min = 1),
numericInput("n_steps", "Number of Time Steps:", 1000, min = 10, step = 10),
actionButton("run", "Run Simulation")
),
mainPanel(
plotOutput("price_plot"),
plotOutput("inventory_plot"),
plotOutput("pnl_plot"),
tableOutput("summary")
)
)
)
# Define server logic
server <- function(input, output) {
# Reactive simulation triggered by button
simulation <- eventReactive(input$run, {
# Parameters
initial_price <- input$initial_price
spread <- input$spread / 100
volatility <- input$volatility / 100
inventory_limit <- input$inventory_limit
n_steps <- input$n_steps
# Initialize vectors
market_price <- numeric(n_steps)
bid_price <- numeric(n_steps)
ask_price <- numeric(n_steps)
inventory <- numeric(n_steps)
cash <- numeric(n_steps)
pnl <- numeric(n_steps)
market_price[1] <- initial_price
inventory[1] <- 0
cash[1] <- 0
bid_price[1] <- initial_price * (1 - spread / 2)
ask_price[1] <- initial_price * (1 + spread / 2)
pnl[1] <- 0
# Simulate market price (random walk with volatility)
for (t in 2:n_steps) {
market_price[t] <- market_price[t-1] * (1 + rnorm(1, 0, volatility))
bid_price[t] <- market_price[t] * (1 - spread / 2)
ask_price[t] <- market_price[t] * (1 + spread / 2)
# Simulate trades (simple model: random trade direction if within spread)
trade_prob <- runif(1)
if (trade_prob < 0.45 && abs(inventory[t-1]) < inventory_limit) {
# Buy order hits bid
inventory[t] <- inventory[t-1] + 1
cash[t] <- cash[t-1] - bid_price[t]
} else if (trade_prob > 0.55 && abs(inventory[t-1]) < inventory_limit) {
# Sell order hits ask
inventory[t] <- inventory[t-1] - 1
cash[t] <- cash[t-1] + ask_price[t]
} else {
inventory[t] <- inventory[t-1]
cash[t] <- cash[t-1]
}
# Calculate P&L (cash + inventory value at market price)
pnl[t] <- cash[t] + inventory[t] * market_price[t]
}
# Return results as data frame
data.frame(
Time = 1:n_steps,
Market_Price = market_price,
Bid_Price = bid_price,
Ask_Price = ask_price,
Inventory = inventory,
Cash = cash,
PnL = pnl
)
})
# Plot market price and quotes
output$price_plot <- renderPlot({
data <- simulation()
ggplot(data, aes(x = Time)) +
geom_line(aes(y = Market_Price, color = "Market Price")) +
geom_line(aes(y = Bid_Price, color = "Bid Price"), linetype = "dashed") +
geom_line(aes(y = Ask_Price, color = "Ask Price"), linetype = "dashed") +
labs(title = "Market Price and Quotes", y = "Price", color = "Legend") +
theme_minimal()
})
# Plot inventory
output$inventory_plot <- renderPlot({
data <- simulation()
ggplot(data, aes(x = Time, y = Inventory)) +
geom_line(color = "blue") +
labs(title = "Inventory Over Time", y = "Inventory") +
theme_minimal()
})
# Plot P&L
output$pnl_plot <- renderPlot({
data <- simulation()
ggplot(data, aes(x = Time, y = PnL)) +
geom_line(color = "green") +
labs(title = "Profit and Loss Over Time", y = "P&L") +
theme_minimal()
})
# Summary table
output$summary <- renderTable({
data <- simulation()
data.frame(
Metric = c("Final P&L", "Final Inventory", "Average Spread", "Total Trades"),
Value = c(
round(tail(data$PnL, 1), 2),
tail(data$Inventory, 1),
round(mean(data$Ask_Price - data$Bid_Price), 2),
sum(abs(diff(data$Inventory)))
)
)
})
}
# Run the application
shinyApp(ui = ui, server = server)
