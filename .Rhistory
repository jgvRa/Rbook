# Define server logic
server <- function(input, output) {
# Reactive simulation triggered by button
simulation <- eventReactive(input$run, {
# Parameters
ticker <- input$ticker
capital_limit <- input$capital_limit
spread <- input$spread / 100
inventory_limit <- input$inventory_limit
n_steps <- input$n_steps
skew_factor <- 0.01  # Controls quote skew based on inventory
# Fetch real-time data (using quantmod)
# For simplicity, use recent daily data; adjust period for intraday if needed
tryCatch({
stock_data <- getSymbols(ticker, src = "yahoo", auto.assign = FALSE,
from = Sys.Date() - 30, to = Sys.Date())
market_price <- as.numeric(Cl(stock_data))  # Use closing prices
}, error = function(e) {
stop("Error fetching data for ticker ", ticker, ". Please check the ticker or internet connection.")
})
# Truncate or repeat data to match n_steps
if (length(market_price) < n_steps) {
market_price <- rep(market_price, length.out = n_steps)
} else {
market_price <- tail(market_price, n_steps)
}
# Initialize vectors
bid_price <- numeric(n_steps)
ask_price <- numeric(n_steps)
inventory <- numeric(n_steps)
cash <- numeric(n_steps)
pnl <- numeric(n_steps)
total_buy_cost <- numeric(n_steps)  # Track total cost of buy trades
inventory[1] <- 0
cash[1] <- 0
total_buy_cost[1] <- 0
bid_price[1] <- market_price[1] * (1 - spread / 2)
ask_price[1] <- market_price[1] * (1 + spread / 2)
pnl[1] <- 0
# Market-making simulation
for (t in 2:n_steps) {
# Calculate quote skew based on inventory
inventory_skew <- -inventory[t-1] * skew_factor / inventory_limit
mid_price <- market_price[t]
# Set bid and ask prices with skew
bid_price[t] <- mid_price * (1 - spread / 2 + inventory_skew)
ask_price[t] <- mid_price * (1 + spread / 2 + inventory_skew)
# Ensure bid-ask prices are positive and reasonableserv reasonable
bid_price[t] <- max(bid_price[t], 0.01)
ask_price[t] <- max(ask_price[t], bid_price[t] + 0.01)
# Simulate trades based on quote attractiveness
bid_prob <- 0.5 * exp(-(market_price[t] - bid_price[t]) / (mid_price * spread))
ask_prob <- 0.5 * exp(-(ask_price[t] - market_price[t]) / (mid_price * spread))
# Check if buy trade would exceed capital limit
can_buy <- (total_buy_cost[t-1] + bid_price[t]) <= capital_limit
if (abs(inventory[t-1]) < inventory_limit) {
trade_type <- runif(1)
if (trade_type < bid_prob && can_buy) {
# Buy order hits bid
inventory[t] <- inventory[t-1] + 1
cash[t] <- cash[t-1] - bid_price[t]
total_buy_cost[t] <- total_buy_cost[t-1] + bid_price[t]
} else if (trade_type < bid_prob + ask_prob) {
# Sell order hits ask
inventory[t] <- inventory[t-1] - 1
cash[t] <- cash[t-1] + ask_price[t]
total_buy_cost[t] <- total_buy_cost[t-1]  # Sell trades don't affect buy cost
} else {
# No trade
inventory[t] <- inventory[t-1]
cash[t] <- cash[t-1]
total_buy_cost[t] <- total_buy_cost[t-1]
}
} else {
# Inventory limit reached, no new trades
inventory[t] <- inventory[t-1]
cash[t] <- cash[t-1]
total_buy_cost[t] <- total_buy_cost[t-1]
}
# Calculate P&L
pnl[t] <- cash[t] + inventory[t] * market_price[t]
}
# Return results as data frame
data.frame(
Time = 1:n_steps,
Market_Price = market_price,
Bid_Price = bid_price,
Ask_Price = ask_price,
Inventory = inventory,
Cash = cash,
PnL = pnl,
Total_Buy_Cost = total_buy_cost
)
})
# Plot market price and quotes
output$price_plot <- renderPlot({
data <- simulation()
ggplot(data, aes(x = Time)) +
geom_line(aes(y = Market_Price, color = "Market Price")) +
geom_line(aes(y = Bid_Price, color = "Bid Price"), linetype = "dashed") +
geom_line(aes(y = Ask_Price, color = "Ask Price"), linetype = "dashed") +
labs(title = paste("Market Price and Quotes for", input$ticker), y = "Price", color = "Legend") +
theme_minimal()
})
# Plot inventory
output$inventory_plot <- renderPlot({
data <- simulation()
ggplot(data, aes(x = Time, y = Inventory)) +
geom_line(color = "blue") +
labs(title = "Inventory Over Time", y = "Inventory") +
theme_minimal()
})
# Plot P&L
output$pnl_plot <- renderPlot({
data <- simulation()
ggplot(data, aes(x = Time, y = PnL)) +
geom_line(color = "green") +
labs(title = "Profit and Loss Over Time", y = "P&L") +
theme_minimal()
})
# Summary table
output$summary <- renderTable({
data <- simulation()
data.frame(
Metric = c("Final P&L", "Final Inventory", "Average Spread", "Total Trades", "Total Buy Cost"),
Value = c(
round(tail(data$PnL, 1), 2),
tail(data$Inventory, 1),
round(mean(data$Ask_Price - data$Bid_Price), 2),
sum(abs(diff(data$Inventory))),
round(tail(data$Total_Buy_Cost, 1), 2)
)
)
})
}
# Run the application
shinyApp(ui = ui, server = server)
